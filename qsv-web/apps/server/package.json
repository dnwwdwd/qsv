    "fastify": "5.12.5",
    "hyparquet": "1.26.0",
    "iconv-lite": "0.6.3",
    "node-sql-parser": "5.4.0",
    "openid-client": "6.8.8",
    "stream-json": "3.5.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^26.6.2",
    "@types/yazl": "3.3.1",
    "typescript": "^5.9.3"
